{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-run=git,deno --allow-read \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-unit.mjs\" --staged"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-run=git,deno --allow-read \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-unit.mjs\" --tree"
          }
        ]
      }
    ]
  }
}
