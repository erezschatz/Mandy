{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "deno",
            "args": ["run", "--quiet", "--allow-run=git,deno", "--allow-read", "--allow-env",
                     "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-unit.mjs", "--staged"],
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno",
            "args": ["run", "--quiet", "--allow-run=git,deno", "--allow-read", "--allow-env",
                     "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-unit.mjs", "--branch"]
          }
        ]
      }
    ]
  }
}
